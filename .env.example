# --- Required ---
BOT_TOKEN=0000000000:replace_me

# Comma-separated Telegram chat IDs where bot is active.
# Example: -1001234567890,-1009876543210
ALLOWED_CHAT_IDS=

# --- LLM ---
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local-llm
LLM_MODEL=Mistral-Small-3.2-24B-Instruct-2506-UD-Q4_K_XL.gguf
LLM_CONTEXT_WINDOW=12000
LLM_CONTEXT_SAFETY_MARGIN=512
MAX_TOKENS=350
TEMPERATURE=0.35
TOP_P=0.85
FREQUENCY_PENALTY=0.15
PRESENCE_PENALTY=0.1

# --- Runtime / DB ---
DB_PATH=./alta_tg_test.db
HISTORY_LIMIT=40
USER_COOLDOWN_SEC=15
ORCHESTRATION_LOG_PATH=./orchestration.log
DEBUG_TRACES=0
ENABLE_DEBUG_LOGS=1
ENABLE_METRICS=1
ENABLE_BACKGROUND_EXTRACTION=1

# --- Creator / profile ---
CREATOR_USER_ID=
CREATOR_PROFILE_PATH=./creator_profile.json

# --- Join verification ---
JOIN_VERIFICATION_TIMEOUT_SEC=45

# --- Media / context ---
MEDIA_CATALOG_PATH=./media_catalog.json
MEDIA_REPLY_PROB=0.22
MEDIA_REPLY_COOLDOWN_SEC=120
KNOWLEDGE_DIR=./knowledge
KNOWLEDGE_MAX_FILES=64
KNOWLEDGE_MAX_FILE_BYTES=262144

# --- Voice replies ---
VOICE_REPLY_PROB=0
VOICE_REPLY_COOLDOWN_SEC=180
VOICE_REPLY_MAX_CHARS=320

# --- ElevenLabs (optional) ---
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE_CODE=
ELEVENLABS_ENABLE_LOGGING=0
ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=
ELEVENLABS_APPLY_TEXT_NORMALIZATION=
ELEVENLABS_SEED=
ELEVENLABS_TIMEOUT_SEC=20
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY_BOOST=
ELEVENLABS_STYLE=
ELEVENLABS_SPEED=
ELEVENLABS_USE_SPEAKER_BOOST=

# --- Search providers (optional) ---
# If set, Russian queries can use Yandex Search API.
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
